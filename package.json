{
  "name": "ta-crypto",
  "version": "0.4.0",
  "description": "Technical analysis for crypto markets in Node.js",
  "type": "module",
  "license": "MIT",
  "author": "",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./indicators": {
      "types": "./dist/indicators.d.ts",
      "import": "./dist/indicators.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./candles": {
      "types": "./dist/candles.d.ts",
      "import": "./dist/candles.js"
    },
    "./stateful": {
      "types": "./dist/stateful.d.ts",
      "import": "./dist/stateful.js"
    }
  },
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "release:check": "npm run check:actions && npm run security:audit && npm test && npm run test:compat:technicalindicators && npm pack --dry-run",
    "check:actions": "node ./scripts/check-actions-pinned.js",
    "security:audit": "node ./scripts/security-audit.js",
    "generate:sbom": "node ./scripts/generate-sbom.js",
    "validate:artifact": "node ./scripts/validate-release-artifact.js",
    "changelog": "node ./scripts/changelog.js",
    "generate:golden": "npm run build && node ./scripts/generate-golden.js",
    "generate:compat": "npm run build && node ./scripts/export-compat-vectors.js",
    "bench": "npm run build && node ./scripts/bench.js",
    "bench:rolling": "npm run build && node ./scripts/bench-rolling.js",
    "bench:stateful": "npm run build && node ./scripts/bench-stateful.js",
    "bench:regression": "npm run build && node ./scripts/bench-regression.js",
    "bench:update-baseline": "npm run build && node ./scripts/bench-update-baseline.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:golden": "npm run build && node --test test/golden.test.mjs",
    "test:compat:technicalindicators": "npm run generate:compat && node ./scripts/compare-technicalindicators.js",
    "test:compat:python": "npm run generate:compat && python ./scripts/compare-python-refs.py",
    "test:compat": "npm run test:compat:technicalindicators && npm run test:compat:python",
    "example:rsi": "npm run build && node ./examples/rsi-strategy.mjs",
    "example:vwap": "npm run build && node ./examples/vwap-session.mjs",
    "example:funding": "npm run build && node ./examples/funding-arbitrage.mjs",
    "example:returns": "npm run build && node ./examples/returns-compounding.mjs",
    "example:rsi:compat": "npm run build && node ./examples/rsi-technicalindicators-check.mjs",
    "example:stateful": "npm run build && node ./examples/stateful-streaming.mjs",
    "example:all": "npm run example:rsi && npm run example:vwap && npm run example:funding && npm run example:returns && npm run example:rsi:compat && npm run example:stateful"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "technicalindicators": "^3.1.0",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "crypto",
    "bitcoin",
    "technical-analysis",
    "indicators",
    "trading",
    "ohlcv"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TDamiao/ta-crypto.git"
  },
  "bugs": {
    "url": "https://github.com/TDamiao/ta-crypto/issues"
  },
  "homepage": "https://github.com/TDamiao/ta-crypto#readme"
}
